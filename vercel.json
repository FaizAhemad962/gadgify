{
  "version": 2,
  "builds": [
    { "src": "backend/api/**/*.{js,ts}", "use": "@vercel/node" },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/backend/api/vercel.ts" },
    { "source": "/health", "destination": "/backend/api/vercel.ts" }
  ]
}

{
  "version": 2,
  "builds": [
    { "src": "backend/api/vercel.js", "use": "@vercel/node" },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/api/vercel.js?path=$1" },
    { "src": "/health", "dest": "/backend/api/vercel.js?path=health" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}

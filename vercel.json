{
  "version": 2,
  "builds": [
    { "src": "backend/api/**/*.{js,ts}", "use": "@vercel/node" },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "^/api/(.*)$", "dest": "/backend/api/vercel.ts?path=$1" },
    { "src": "^/health$", "dest": "/backend/api/vercel.ts?path=health" },
    { "src": "^/(.*)$", "dest": "/frontend/$1" }
  ]
}
